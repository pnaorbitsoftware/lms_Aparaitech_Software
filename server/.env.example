# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net

# ── JWT ─────────────────────────────────────────────────
# Any long random string, e.g. openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here

# ── Cloudinary ──────────────────────────────────────────
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# ── Razorpay ────────────────────────────────────────────
# Key ID starts with rzp_test_ (test) or rzp_live_ (production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (production only)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://aparaitech.org
